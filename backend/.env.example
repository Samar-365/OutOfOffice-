# ==============================================================================
# OutOfOffice AI — Environment Variables
# Hacktoberfest 2026: Open-Source AI Challenge (Week 1: "Touch Grass")
# ==============================================================================

# Application & API
APP_NAME="OutOfOffice AI"
ENVIRONMENT="development"
DEBUG=true
API_HOST="127.0.0.1"
API_PORT=8000

# Local AI Inference (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_MODEL="gemma2:9b"
FALLBACK_MODEL="gemma2:2b"
CODE_SPECIALIST_MODEL="codegemma"
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=120

# Partner Integration: Sentry Agent Tracing (Optional)
SENTRY_DSN=""

# Partner Integration: ElevenLabs Voice Briefing (Optional - fallback to Web Speech)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"

# Safety Constraints
MAX_COMMAND_TIMEOUT_SECONDS=60
ALLOW_REMOTE_GIT_PUSH=false
