# ==============================================================================
# OutOfOffice AI — Environment Configuration (.env)
# ==============================================================================
# NOTE: All API keys are 100% OPTIONAL. The app works fully offline out-of-the-box!

# 1. Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gemma2:9b
FALLBACK_MODEL=gemma2:2b
CODE_SPECIALIST_MODEL=codegemma

# 2. Voice Debrief (Optional - ElevenLabs)
# If left empty, the browser's built-in Web Speech Synthesis is used for free.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# 3. Distributed Telemetry (Optional - Sentry)
# If left empty, local in-memory trace collection and waterfall graphs are used.
SENTRY_DSN=
